# Server
PORT=3100
HOST=127.0.0.1

# Mode: "hestia" (Linux HestiaCP) or "local" (local WP folder testing)
FLEET_MODE=hestia
LOCAL_SITES_ROOT=

# Auth (generate hash with: npm run hash-password -- "YourStrongPassword")
COOKIE_SECRET=change-this-to-a-long-random-64-char-secret
ADMIN_USER=admin
ADMIN_PASS_HASH=
COOKIE_SECURE=true

# Paths
DATA_DIR=./data
REPO_DIR=/opt/wp-repo
BACKUP_DIR=/var/backups/wp-fleet
WP_CLI_BIN=/usr/local/bin/wp
HELPER_BIN=/usr/local/sbin/wp-fleet-helper

# Concurrency & Retention
JOB_CONCURRENCY=2
SNAPSHOT_RETENTION_DAYS=14

# Self-Update (GitHub repo slug, e.g. "username/wp-fleet")
GITHUB_REPO=
